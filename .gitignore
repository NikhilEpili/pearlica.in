.DS_Store
uploads.zip

migrations/*
# Media binaries live on the server outside git (pearlica-media/).
# Keep only security stubs + empty dir markers in the repo so Hostinger
# deploy never overwrites production uploads with a stale git tree.
uploads/**
!uploads/.htaccess
!uploads/**/
!uploads/**/.htaccess
!uploads/**/.gitkeep
# Admin-saved Razorpay settings (runtime; contains key secrets)
storage/razorpay.mode
storage/razorpay.settings.json
storage/cache/

# Blogs: Ignore everything in blogs except index.php, post.php, and rss.php
blogs/*
!blogs/index.php
!blogs/post.php
!blogs/rss.php
