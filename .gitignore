.DS_Store
uploads.zip

migrations/*
# Keep product/collection/banner media in git for Hostinger deploy.
# Still ignore archives / OS junk under uploads (GitHub 100MB file limit).
uploads/**/*.zip
uploads/**/*.rar
uploads/**/*.7z
uploads/**/.DS_Store
# Admin-saved Razorpay settings (runtime; contains key secrets)
storage/razorpay.mode
storage/razorpay.settings.json
storage/cache/

# Blogs: Ignore everything in blogs except index.php, post.php, and rss.php
blogs/*
!blogs/index.php
!blogs/post.php
!blogs/rss.php
